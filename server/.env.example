# Runtime
NODE_ENV=development
PORT=4000

# MongoDB connection string.
# Local (docker compose):  mongodb://localhost:27017/fleetpilot
# Atlas:                   mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/fleetpilot?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/fleetpilot

# Auth — use long random strings in production (e.g. `openssl rand -hex 32`).
# Access and refresh tokens use separate secrets.
JWT_SECRET=dev-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Email OTP delivery (Resend). Leave RESEND_API_KEY empty in dev/CI to log
# OTP codes to the server console instead of sending real email.
RESEND_API_KEY=
EMAIL_FROM=FleetPilot <onboarding@resend.dev>

# Multi-factor authentication (TOTP) issuer shown in authenticator apps.
MFA_ISSUER=FleetPilot

# Public URL of the frontend (used in email links / references).
CLIENT_URL=https://hb-source.github.io/Car-Fleet-App/

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,https://hb-source.github.io

# Seed script credentials
SEED_ADMIN_EMAIL=admin@fleetpilot.demo
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_DRIVER_PASSWORD=Driver123!

# When true, the server runs the (idempotent) seed automatically on startup.
# Useful for a hosted first deploy; leave false for local development.
SEED_ON_START=false
